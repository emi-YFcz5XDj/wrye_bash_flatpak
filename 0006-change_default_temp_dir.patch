From 3de921abb4f2d2ce66ad0177585661ca81965c06 Mon Sep 17 00:00:00 2001
From: "Alice H." <alice.hall0451+vcs@gmail.com>
Date: Thu, 8 Oct 2026 07:33:52 +0100
Subject: [PATCH 6/7] change_default_temp_dir

Signed-off-by: Alice H. <alice.hall0451+vcs@gmail.com>
---
 Mopy/bash/wbtemp.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Mopy/bash/wbtemp.py b/Mopy/bash/wbtemp.py
index 2996e9fdc..2c34ac787 100644
--- a/Mopy/bash/wbtemp.py
+++ b/Mopy/bash/wbtemp.py
@@ -294,9 +294,11 @@ def _default_global_unix():
                 break
             max_path = mp_parent
         return os.path.join(max_path, '.wbtemp')
+    def _default_global_flatpak():
+        return os.path.join(bolt.GPath(os.getenv('XDG_CACHE_HOME')), 'wrye-bash')
     match platform.system():
         case 'Windows': return _default_global_win()
-        case 'Linux': return _default_global_unix()
+        case 'Linux': return _default_global_flatpak()
         case 'Darwin': return _default_global_unix()
         case _: raise RuntimeError(f'wbtemp.py does not support '
                                    f'{platform.system()} yet')
