From f0d6865ed5686c87f74309bd9066a08e0925d743 Mon Sep 17 00:00:00 2001
From: "Alice H." <alice.hall0451+vcs@gmail.com>
Date: Thu, 8 Oct 2026 07:33:11 +0100
Subject: [PATCH 3/7] read_bash_ini_from_xdg_config_home

Signed-off-by: Alice H. <alice.hall0451+vcs@gmail.com>
---
 Mopy/bash/bash.py    | 2 +-
 Mopy/bash/gen_ini.py | 9 +++++----
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/Mopy/bash/bash.py b/Mopy/bash/bash.py
index c11809f0d..995dd5ee2 100644
--- a/Mopy/bash/bash.py
+++ b/Mopy/bash/bash.py
@@ -531,7 +531,7 @@ def _main(opts, wx_locale, _wx):
     instance = _wx.SingleInstanceChecker(u'Wrye Bash') # must stay alive !
     assure_single_instance(instance)
     # We need the Mopy dirs to initialize restore settings instance
-    bash_ini_path, restore_ = u'bash.ini', None
+    bash_ini_path, restore_ = os.path.join(os.getenv('XDG_CONFIG_HOME'), 'bash_default.ini'), None
     # import barb, which does not import from bosh/bush
     from . import barb
     if opts.restore:
diff --git a/Mopy/bash/gen_ini.py b/Mopy/bash/gen_ini.py
index ef4898c7a..74054f0dc 100644
--- a/Mopy/bash/gen_ini.py
+++ b/Mopy/bash/gen_ini.py
@@ -24,7 +24,7 @@
 
 __author__ = 'sibir'
 
-from os import path
+from os import path, getenv
 from textwrap import fill
 from zlib import crc32
 
@@ -556,11 +556,12 @@ def _generate_default_bash_ini():
 def write_default_bash_ini():
     """Write bash_default.ini if missing or changed."""
     default_bash_ini, default_ini_crc = _generate_default_bash_ini()
-    if path.exists('bash_default.ini'):
-        with open('bash_default.ini', 'r') as f:
+    bash_ini_path = path.join(getenv('XDG_CONFIG_HOME'), 'bash_default.ini')
+    if path.exists(bash_ini_path):
+        with open(bash_ini_path, 'r') as f:
             curr_default_ini_crc = crc32(f.read().encode())
     else:
         curr_default_ini_crc = 0
     if curr_default_ini_crc != default_ini_crc:
-        with open('bash_default.ini', 'w') as f:
+        with open(bash_ini_path, 'w') as f:
             f.write(default_bash_ini)
-- 
